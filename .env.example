# Vercel > Project Settings > Environment Variables
# Add secrets there. Never commit actual credentials.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token with Contents: Read/Write (this repo only).
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=kaveethmanodhya/Kaveeth-Manodhya
# Use feature branch for preview; switch to live film branch when merged.
GITHUB_CONTENT_BRANCH=feature/film-portfolio-admin

# Cloudinary Dashboard > API Keys (server-side only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
