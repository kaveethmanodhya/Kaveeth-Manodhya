# Configure these in your local .env.local AND Vercel Environment Variables.
# Use a strong unique password (12+ characters) and a random 32+ character secret.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Fine-grained GitHub token: Contents Read and Write; only this repository.
# Never expose this token in NEXT_PUBLIC_ variables.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=kaveethmanodhya/Kaveeth-Manodhya
GITHUB_CONTENT_BRANCH=main
